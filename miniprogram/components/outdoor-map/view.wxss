.map-heading, .map-toolbar, .map-options, .map-center, .selected-place, .outing-actions, .outing-heading, .time-fields, .places-heading {
  display: flex;
  align-items: center;
}

.map-heading { justify-content: space-between; gap: 8px; margin: 2px 0 10px; }
.map-heading .heading { font-size: 22px; }
.eyebrow { margin-bottom: 2px; color: #13695c; font-size: 12px; font-weight: 700; }
.radius {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 0 8px;
  border: 1rpx solid #cddfd8;
  border-radius: 8px;
  background: #fff;
  color: #13695c;
  font-size: 14px;
  font-weight: 650;
  white-space: nowrap;
}
.map-panel { padding: 16rpx; }
.map-toolbar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; margin-bottom: 5px; }
.map-toolbar .text-button { --button-width: 100%; min-width: 0; padding: 4px 2px; }
.native-map { display: block; width: 100%; height: 494rpx; border-radius: 14rpx; background: #e5efea; }
.map-center, .map-options { justify-content: space-between; gap: 4px; padding: 4px 3px 0; font-size: 13px; }
.center-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.map-center .text-button { flex: none; }
.map-options { margin: 6rpx 0; }
.ordinary-toggle { display: flex; align-items: center; gap: 6rpx; }
.ordinary-switch { flex: none; }
.map-note { margin: 4px 3px 0; font-size: 13px; }
.map-error { margin: 8rpx 6rpx; }
.address-panel { padding: 8rpx 4rpx 12rpx; }
.address-form { display: flex; gap: 12rpx; }
.search-input { flex: 1; min-width: 0; }
.search-button { flex: none; padding: 6px 8px; font-size: 14px; }
.address-item { --button-width: 100%; display: flex; flex-direction: column; align-items: flex-start; padding: 6px 8px; text-align: left; }
.selected-place { justify-content: space-between; gap: 16rpx; margin-top: 10rpx; padding: 18rpx; border-radius: 16rpx; background: #eaf4f0; }
.destination { flex: 1; min-width: 0; }
.place-name { font-size: 15px; font-weight: 700; overflow-wrap: anywhere; }
.place-address { font-size: 13px; overflow-wrap: anywhere; }
.distance { color: #13695c; white-space: nowrap; }
.distance .muted { font-size: 12px; }
.direction-button { flex: none; padding: 6px 8px; font-size: 14px; }
.outing-actions { gap: 12rpx; margin: 16rpx 0; }
.action { flex: 1; min-width: 0; padding: 6px 3px; border: 1rpx solid #cddfd8; border-radius: 16rpx; background: #fff; font-weight: 650; }
.outing-panel { margin-bottom: 16rpx; }
.outing-heading, .places-heading { justify-content: space-between; margin-bottom: 16rpx; }
.time-fields { gap: 10rpx; }
.date-picker { flex: 3; min-width: 0; }
.time-picker { flex: 2; min-width: 0; }
.time-fields .input { white-space: nowrap; }
.outing-save { --button-width: 100%; margin-top: 16rpx; }
.outing-error { margin-top: 16rpx; }
.outing-result { padding: 12rpx; border-radius: 12rpx; background: #eaf4f0; }
.places-heading .muted { font-size: 13px; }
.place-row { --button-width: 100%; display: flex; align-items: center; gap: 12rpx; border-top: 1rpx solid #dae7e2; border-radius: 0; text-align: left; }
.place-row.selected-row { border-radius: 12rpx; background: #eaf4f0; }
.place-description { flex: 1; min-width: 0; }
.place-tag { flex: none; padding: 4rpx 8rpx; border-radius: 8rpx; background: #e9edec; color: #405950; font-size: 20rpx; }
.place-tag.accessible { background: #dcefeb; color: #115f53; }
.map-canvas { position: relative; }
.map-status { position: absolute; top: 7px; left: 7px; z-index: 2; display: flex; align-items: center; gap: 4px; padding: 3px 7px 3px 3px; border: 1rpx solid #c6dcd4; border-radius: 15px; background: #f7fcf9; color: #194b48; font-size: 10px; line-height: 1.45; text-align: left; box-shadow: 0 3px 12px #163c3726; }
.map-status::after { border: 0; }
.map-status-time { font-size: 12px; font-weight: 650; }
.map-pearl { position: relative; flex: none; width: 39px; height: 39px; overflow: hidden; border: 1rpx solid #99c6bc; border-radius: 50%; background: radial-gradient(circle at 30% 23%, #fff, #b7dcd5); }
.map-water { position: absolute; bottom: 0; width: 100%; border-radius: 33% 40% 0 0; background: linear-gradient(#7cdabd, #33997c); }
.embedded-map .map-heading .heading { font-size: 15px; }
.embedded-map .native-map { height: clamp(195px, 41vh, 420px); }
