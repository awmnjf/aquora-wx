.page-title { font-size: 42rpx; margin-bottom: 12rpx; }
.intro, .research-page .panel, .success-box { margin-bottom: 24rpx; }
.intro, .section-copy { line-height: 1.6; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 14rpx; }
.section-copy { margin: 12rpx 0 20rpx; }
.chip { flex-shrink: 0; border-radius: 30rpx; padding: 4rpx 14rpx; color: #236255; background: #d8eee4; font-size: 22rpx; }
.check-row { display: flex; align-items: flex-start; gap: 10rpx; }
.success-box, .notice-target { padding: 16rpx 20rpx; border-radius: 14rpx; background: #e5f2ed; color: #236255; }
.notice-target text { display: block; font-weight: 650; }
.window-row { padding: 18rpx 0 6rpx; border-top: 1rpx solid #e4eee9; }
.window-title { margin: 0 0 5rpx; font-size: 26rpx; font-weight: 650; }
.window-origin { font-size: 24rpx; }
.label-button { margin-top: 8rpx; padding-left: 0; }
.start-button { margin-bottom: 20rpx; }
.leave-button { color: #87392c; }
.timestamp { font-size: 26rpx; }
